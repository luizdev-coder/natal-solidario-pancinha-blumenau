        <!-- Lado Direito: Mensagem de Agradecimento -->
        <div class="footer-thanks">
          <span class="thanks-heart">❤️</span>
          <p>"Agradecemos de coração o seu apoio!"</p>
        </div>
      </div>

      <div class="footer-bottom">
        Feito com amor e carinho pela comunidade. Unidos por um Natal iluminado para todas as crianças! 🎄
      </div>
    </div>
  </footer>

  <!-- ========================================================================
       7. ELEMENTOS FLUTUANTES (FIXOS NA TELA)
       ======================================================================== -->

  <!-- Gatilho Flutuante para Abrir a Janela do Chatbot -->
  <button class="floating-chat-trigger" id="floating-chat-trigger" aria-label="Abrir Assistente Natalina">
    🦌
    <span class="chat-trigger-badge" id="chat-trigger-badge">1</span>
  </button>

  <!-- Janela do Chatbot (Assistente Natalina) -->
  <aside class="chatbot-window collapsed" id="chatbot-window" aria-label="Assistente Natalina do Pancinha">
    <!-- Cabeçalho do Chat -->
    <div class="chat-header">
      <div class="chat-header-info">
        <div class="chat-header-icon">🦌</div>
        <div class="chat-header-text">
          <h3>ASSISTENTE NATALINA DO PANCINHA</h3>
          <span class="chat-status">
            <span class="status-dot"></span> Online agora
          </span>
        </div>
      </div>
      <button class="chat-close-btn" id="chat-close-btn" aria-label="Fechar Janela do Chat">&times;</button>
    </div>

    <!-- Área de Mensagens -->
    <div class="chat-body" id="chat-body">
      <!-- Mensagem de Boas-Vindas do Bot -->
      <div class="chat-msg bot">
        <div class="chat-bubble">
          Olá! Como posso ajudar você hoje? 🎄✨ Escolha uma pergunta rápida abaixo ou escreva sua dúvida:
        </div>
        <span class="chat-time">Hoje</span>
      </div>

      <!-- Botões de Perguntas Frequentes Requisitados -->
      <div class="chat-quick-actions">
        <button class="quick-btn" data-faq="faq1">
          <span>Como funciona a doação?</span>
          <span>→</span>
        </button>
        <button class="quick-btn" data-faq="faq_coleta">
          <span>📍 Pontos de coleta em Blumenau</span>
          <span>→</span>
        </button>
        <button class="quick-btn" data-faq="faq2">
          <span>Onde as cestas são entregues?</span>
          <span>→</span>
        </button>
        <button class="quick-btn" data-faq="faq3">
          <span>Até quando posso doar?</span>
          <span>→</span>
        </button>
      </div>

      <!-- Indicador de Digitação -->
      <div class="typing-indicator" id="typing-indicator">
        <div class="typing-dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>

    <!-- Rodapé do Chat (Input de Texto) -->
    <div class="chat-footer">
      <input 
        type="text" 
        id="chat-input" 
        class="chat-input" 
        placeholder="Digite sua dúvida aqui..." 
        aria-label="Digite sua mensagem para a Assistente Natalina"
      >
      <button type="button" id="chat-send-btn" class="chat-send-btn" aria-label="Enviar Mensagem">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"></line>
          <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </div>
  </aside>

  <!-- Botão Flutuante do WhatsApp -->
  <a href="https://wa.me/5547991092967?text=Ol%C3%A1!%20Vim%20pelo%20site%20do%20Natal%20Solid%C3%A1rio%20do%20Pancinha%202026%20e%20gostaria%20de%20ajudar!" 
     target="_blank" 
     rel="noopener noreferrer" 
     class="floating-whatsapp-btn" 
     id="floating-whatsapp-btn" 
     aria-label="Conversar no WhatsApp">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.311.045-.698.059-1.146-.086-.285-.093-.654-.234-1.147-.447-2.002-.868-3.308-2.893-3.409-3.028-.1-.134-.812-1.082-.812-2.064 0-.982.51-1.465.69-1.666.182-.202.398-.252.531-.252.133 0 .265.002.382.008.125.006.292-.047.457.35.17.408.577 1.409.627 1.512.051.103.085.224.017.359-.068.134-.102.219-.203.337-.101.119-.213.265-.304.356-.102.102-.208.213-.089.417.119.204.529.873 1.135 1.413.782.696 1.439.912 1.644 1.014.204.102.323.085.441-.051.119-.136.51-.594.646-.798.136-.204.272-.17.458-.102.186.068 1.17.552 1.373.654.203.102.339.153.39.237.051.085.051.491-.093.896z"/>
    </svg>
    <span>Conversar</span>
  </a>

  <!-- Toast Notification para Cópia de Chave Pix -->
  <div class="toast-msg" id="toast-msg" role="status" aria-live="polite">
    Chave Pix copiada com sucesso!
  </div>

  <!-- Scripts -->
  <script src="js/snowflakes.js"></script>
  <script src="js/chatbot.js"></script>
  <script src="js/main.js"></script>
</body>
</html>
